{
  "name": "parallax",
  "productName": "Parallax",
  "version": "0.2.0",
  "description": "A desktop chat app for running Claude, GPT, Gemini and any OpenAI-compatible model side by side (with your API keys or your ChatGPT plan): broadcast one prompt to many sessions, compare the answers, or put several models in one group chat.",
  "author": "Houchen181",
  "license": "MIT",
  "homepage": "https://github.com/Houchen181/parallax",
  "repository": {
    "type": "git",
    "url": "https://github.com/Houchen181/parallax.git"
  },
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:web": "vite build --mode web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "mock": "node scripts/mock-llm-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "diff": "^9.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "katex": "^0.18.10",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
